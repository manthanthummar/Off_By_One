# FarmSense Environment Configuration

# Authentication API Key (Clients must send header X-API-Key)
FARMSENSE_API_KEY=farmsense-dev-key

# Database URL (PostgreSQL in production; if unset or empty, automatically defaults to SQLite sqlite:///./farmsense.db)
DATABASE_URL=postgresql+psycopg://farmsense:farmsense-password@localhost:5432/farmsense

# Anthropic Claude API Key (Optional: system runs with zero-LLM deterministic fallback when empty)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# MQTT Broker (Optional: system runs REST /ingest fallback when empty)
MQTT_HOST=localhost
MQTT_PORT=1883

# Background MQTT Auto-Orchestration Interval (seconds; 0 = disabled)
AUTO_ORCHESTRATE_INTERVAL=10

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
